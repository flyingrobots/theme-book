#!/usr/bin/env bash
set -euo pipefail

resolve_script_path() {
  local p="$1"
  while [[ -L "$p" ]]; do
    local dir
    dir="$(cd -P "$(dirname "$p")" && pwd)"
    local target
    target="$(readlink "$p")"
    case "$target" in
      /*) p="$target" ;;
      *)  p="$dir/$target" ;;
    esac
  done
  local dir
  dir="$(cd -P "$(dirname "$p")" && pwd)"
  printf '%s/%s\n' "$dir" "$(basename "$p")"
}

SCRIPT_REAL="$(resolve_script_path "${BASH_SOURCE[0]}")"
ROOT_DIR="$(cd -P "$(dirname "$SCRIPT_REAL")/.." && pwd)"

exec bun "$ROOT_DIR/src/cli.ts" "$@"
